# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.
# Never put AWS keys here: Terraform reads credentials from `aws configure` / environment variables.

aws_region          = "ap-south-1"
project_name        = "clinicflow"
environment         = "dev"
vpc_cidr            = "10.30.0.0/16"
kubernetes_version  = "1.34"
node_instance_types = ["t3.medium"]
node_desired_size   = 2
node_min_size       = 2
node_max_size       = 3
